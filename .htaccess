<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jangan proses ulang jika file atau folder tersedia
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Arahkan seluruh request ke folder public Laravel
    RewriteRule ^(.*)$ /aisnu/public/$1 [L]
</IfModule>